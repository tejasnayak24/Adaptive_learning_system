# Aegis backend configuration.
# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored: never commit it.

# PostgreSQL connection: postgresql://<user>:<password>@<host>:<port>/<database>
# Create the database first (README section 2).
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/adaptive_learning_db

# Secret used to sign login tokens (JWT). The backend refuses to start with
# this placeholder. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
# How long a login lasts, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Kept for compatibility; currently not used by the backend.
DEBUG=False

# Log every SQL statement (includes bound parameters such as e-mails and
# password hashes). Keep False except when debugging queries locally.
SQL_ECHO=False

# Frontend (optional, set in the shell before `npm run dev`, not here):
#   AEGIS_API_URL       backend URL for the dev proxy (default http://127.0.0.1:8000)
#   AEGIS_DEV_HOST      dev-server bind address (default 127.0.0.1; 0.0.0.0 exposes it on the LAN)
#   AEGIS_FRONTEND_PORT dev-server port (default 5173; the camera agent only accepts 5173)
