# Database Configuration
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/adaptive_learning_db

# Authentication
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Development
DEBUG=True

# Log every SQL statement (includes bound parameters such as e-mails and
# password hashes). Keep False except when debugging queries locally.
SQL_ECHO=False